# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.deepeval/
.cache/
variance_results.json

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Environments
.env
.venv/
venv/
env/

# Bicep parameter files can hold real secret values (e.g. apiKeyValue) - never commit
# one. Pass secrets via `--parameters apiKeyValue=$AEG_API_KEY` at deploy time instead.
*.bicepparam

# IDE / OS
.vscode/
.idea/
.DS_Store

# Streamlit local secrets override (a project-local secrets.toml can hold a real
# API key) - never commit one; pass AEG_API_KEY via .env or the deploy platform's
# own secrets manager instead. config.toml (theme only, no secrets) IS committed.
.streamlit/secrets.toml

# Private/local-only notes (not part of the public repo) - build_log.md and
# mentoring_notes.md both live here now (Day 9 / Step 1: previously split across
# this folder and a separate docs/, consolidated into one).
internal/
